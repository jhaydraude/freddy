# External MongoDB Connection
# Examples:
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nightscout
# Self-hosted: mongodb://hostname:27017/nightscout
# Local with auth: mongodb://username:password@localhost:27017/nightscout
MONGO_URI=mongodb://your-mongodb-host:27017/nightscout

# Prediction Service (internal Docker network)
PREDICTION_SERVICE_URL=http://prediction-service:8000

# LLM Service
GEMINI_API_KEY=your_api_key_here

# Node Environment
NODE_ENV=production
