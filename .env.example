# --- REQUIRED SECRETS ---

# Your MongoDB connection string (Atlas or self-hosted)
# Required for WebApp only.
MONGO_URI=mongodb://localhost:27017/nightscout

# Google Gemini API Key
# Required for AI features (Profile Explanations, Situation Analysis).
GEMINI_API_KEY=your_key_here


# --- APPLICATION DEFAULTS ---

# Prediction Service URL
# Internal Docker: http://prediction-service:8000
# External/Local: http://localhost:8000
PREDICTION_SERVICE_URL=http://prediction-service:8000

# Environment: production or development
NODE_ENV=production
ENVIRONMENT=production

# Logging: INFO or DEBUG
LOG_LEVEL=INFO

# CORS: Domains allowed to call the prediction service
ALLOWED_ORIGINS=http://localhost:3000
