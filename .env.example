# --- REQUIRED SECRETS ---

# Your MongoDB connection string - Must point directly to a Freddy database.
# Run 'npm run setup-db' to initialize freddy_db and freddy_db_dev.
MONGO_URI=mongodb://localhost:27017/freddy_db_dev

# Optional: Nightscout MongoDB URI (used during transition phase)
NIGHTSCOUT_MONGO_URI=mongodb://localhost:27017/nightscout

# Google Gemini API Key
# Required for AI features (Profile Explanations, Situation Analysis).
GEMINI_API_KEY=your_key_here


# --- APPLICATION DEFAULTS ---

# Prediction Service URL
# Internal Docker: http://prediction-service:8000
# External/Local: http://localhost:8000
PREDICTION_SERVICE_URL=http://prediction-service:8000

# Environment: production or development
NODE_ENV=production
ENVIRONMENT=production

# Logging: INFO or DEBUG
LOG_LEVEL=INFO

# CORS: Domains allowed to call the prediction service
ALLOWED_ORIGINS=http://localhost:3000
