# External MongoDB Connection
# Examples:
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/nightscout
# Self-hosted: mongodb://hostname:27017/nightscout
# Local: mongodb://localhost:27017/nightscout
MONGO_URI=mongodb://localhost:27017/nightscout

# Prediction Service URL
# For local development: http://localhost:8000
# For Docker: http://prediction-service:8000
PREDICTION_SERVICE_URL=http://localhost:8000

# LLM Service (optional - for AI-powered features)
GEMINI_API_KEY=

# Node Environment
NODE_ENV=development
